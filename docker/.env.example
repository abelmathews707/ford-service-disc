# Copy to .env and edit. Paths may be absolute or relative to this folder.

# Where the built site lives on the host. Required.
SITE=/srv/ford/site

# The disc image or mounted disc. Only needed for the `build` profile.
#DISC=/srv/ford/IMAGE.img

# Port to publish on, and what to bind to. The default only listens on
# loopback; use 0.0.0.0 to reach it from other machines on your network.
PORT=8848
BIND=0.0.0.0
